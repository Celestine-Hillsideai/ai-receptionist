{
  "mcpServers": {
    "n8n-mcp": {
      "command": "node",
      "args": ["tools/n8n-mcp/dist/mcp/stdio-wrapper.js"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "",
        "WEBHOOK_SECURITY_MODE": "moderate"
      }
    }
  }
}
