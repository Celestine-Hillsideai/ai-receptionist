# AI Office Receptionist — environment configuration template.
# Copy to .env and fill in real values. Never commit .env itself.
# Source of truth for this list: workflows/build-ai-receptionist.md §34 (Configuration).

APP_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional — defaults to gpt-5-mini if unset. Verify this is still the right
# cheap/fast model for structured extraction against your account before
# relying on it; model lineups change (see lib/providers/openai/extractCallData.ts).
OPENAI_EXTRACTION_MODEL=

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Used by tools/vapi/sync-assistant.js (Phase 4) to sync the live Vapi
# assistant's system prompt (from prompts/receptionist-voice.v1.md) and
# webhook server.url. VAPI_SERVER_CREDENTIAL_ID is the one that matters once
# VAPI_ASSISTANT_ID already points at a real assistant — see the one-time
# Custom Credential setup in tools/vapi/README.md. The rest
# (OFFICE_NAME/VAPI_MODEL*/VAPI_VOICE*/VAPI_TRANSCRIBER*) only apply when
# bootstrapping a brand new assistant from scratch (no VAPI_ASSISTANT_ID
# set yet) — they're not injected into an existing assistant's config.
VAPI_SERVER_CREDENTIAL_ID=
OFFICE_NAME=
VAPI_ASSISTANT_NAME=
VAPI_FIRST_MESSAGE=
VAPI_END_CALL_MESSAGE=
VAPI_MODEL_PROVIDER=
VAPI_MODEL=
VAPI_MODEL_CREDENTIAL_ID=
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_CREDENTIAL_ID=
VAPI_TRANSCRIBER_PROVIDER=
VAPI_TRANSCRIBER_MODEL=
VAPI_TRANSCRIBER_LANGUAGE=

N8N_BASE_URL=
N8N_WEBHOOK_URL=

# Not in the spec's §34 list — authenticates n8n's callback into this app's
# internal endpoints (e.g. /api/internal/analyze-call). Same shared-secret
# pattern as VAPI_WEBHOOK_SECRET; unset is fine for local dev only.
INTERNAL_API_SECRET=

EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SECRETARY_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

LOG_LEVEL=info
